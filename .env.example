# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA STERENFIX (CAKEPHP + MYSQL 8.0)
# ==============================================================================

# Configuración de Aplicación CakePHP
APP_NAME="Sterenfix - Sistema de Personal"
APP_ENV="development"
DEBUG="true"
APP_ENCODING="UTF-8"
APP_DEFAULT_LOCALE="es_ES"
APP_DEFAULT_TIMEZONE="America/Mexico_City"
SECURITY_SALT="c30d92376e1a0df3311dbb5b991386d38e8ec8e0f6c77bb320c15e8b4e7a68fc"

# Configuración de Servidor Web y Contenedores
APP_PORT=8080

# Credenciales y Conexión a Base de Datos MySQL 8.0
DB_DRIVER="Cake\Database\Driver\Mysql"
DB_HOST="db"
DB_PORT=3306
DB_DATABASE=sterenfix
DB_USERNAME=sterenfix
DB_PASSWORD=SterenfixPassword123#
DB_ROOT_PASSWORD=SterenfixRootPassword123#
