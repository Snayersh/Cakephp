{
    "name": "sterenfix/sistema-personal",
    "description": "Sistema de Gestión de Personal Sterenfix en CakePHP con Oracle Database",
    "homepage": "https://github.com/Snayersh/Cakephp.git",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "~4.5.0",
        "cakephp/chronos": "^2.4",
        "cakephp/plugin-installer": "^1.3",
        "cakedc/cakephp-oracle-driver": "^4.0",
        "mobiledetect/mobiledetectlib": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/"
        }
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "cakephp/plugin-installer": true
        }
    }
}
